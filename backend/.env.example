# Copy to .env and edit. NEVER commit .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_MINUTES=60

DATABASE_URL=sqlite:///./grid_monitor.db
CORS_ORIGINS=http://localhost:5173

# Device liveness / command acknowledgement windows (seconds)
HEARTBEAT_TIMEOUT_S=15
COMMAND_TIMEOUT_S=10

# Used ONLY by seed.py to create the first admin. Choose your own; there are no built-in defaults.
SEED_ADMIN_OPERATOR_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=

# Trained model from Stage 5 (optional until then)
ML_MODEL_PATH=../ml/models/fault_classifier.joblib
ML_METRICS_PATH=../ml/models/metrics.json

# ---- Twilio SMS (optional). Get these from console.twilio.com. NEVER commit the token.
# Trial accounts can only text numbers verified in the Twilio console and prefix messages with "Sent from your Twilio trial account".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use ONE sender: a Twilio phone number in E.164 ...
TWILIO_FROM_NUMBER=
# ... or a Messaging Service SID (starts with MG); it takes precedence when set
TWILIO_MESSAGING_SERVICE_SID=
SMS_SYSTEM_NAME=GRID MONITOR
SMS_TIMEZONE=UTC
# Same fault/offline/boot event: at most one SMS per window. Trips/restores use the shorter window.
SMS_REPEAT_INTERVAL_S=900
SMS_STATE_CHANGE_INTERVAL_S=60
SMS_MAX_AGE_S=900
